---
---

<section id="sobre-mi" class="about-combined">
  <div class="container">
    <!-- About Section -->
    <div class="about-header">
      <h2>Sobre mí</h2>
      <p class="about-intro">
        Construyo experiencias digitales que conectan personas con tecnología. 
        Mi enfoque está en crear soluciones simples para problemas complejos, 
        siempre pensando en quién las va a usar.
      </p>
    </div>

    <div class="about-stats">
      <div class="stat-item">
        <div class="stat-number">6</div>
        <div class="stat-label">Proyectos</div>
      </div>
      <div class="stat-item">
        <div class="stat-number">5</div>
        <div class="stat-label">Clientes</div>
      </div>
      <div class="stat-item">
        <div class="stat-number">100%</div>
        <div class="stat-label">Freelance</div>
      </div>
    </div>

    <!-- Tech Stack Section -->
    <div class="tech-section">
      <h3>Stack tecnológico</h3>
      <div class="tech-categories">
        
        <!-- Frontend & Mobile -->
        <div class="tech-category">
          <h4 class="category-title">Frontend & Mobile</h4>
          <div class="tech-items">
            <div class="tech-item">
              <div class="tech-icon">
                <img src="https://api.iconify.design/logos/react.svg" alt="React" />
              </div>
              <span class="tech-name">React</span>
            </div>
            
            <div class="tech-item">
              <div class="tech-icon">
                <img src="https://api.iconify.design/cib/expo.svg" alt="Expo" />
              </div>
              <span class="tech-name">Expo</span>
            </div>
            
            <div class="tech-item">
              <div class="tech-icon">
                <img src="https://api.iconify.design/logos/flutter.svg" alt="Flutter" />
              </div>
              <span class="tech-name">Flutter</span>
            </div>
            
            <div class="tech-item">
              <div class="tech-icon">
                <img src="/flet.png" alt="Flet" />
              </div>
              <span class="tech-name">Flet</span>
            </div>
            
            <div class="tech-item">
              <div class="tech-icon">
                <img src="https://api.iconify.design/logos/javascript.svg" alt="JavaScript" />
              </div>
              <span class="tech-name">JavaScript</span>
            </div>
            
            <div class="tech-item">
              <div class="tech-icon">
                <img src="https://api.iconify.design/vscode-icons/file-type-html.svg" alt="HTML" />
              </div>
              <span class="tech-name">HTML</span>
            </div>
            
            <div class="tech-item">
              <div class="tech-icon">
                <img src="https://api.iconify.design/vscode-icons/file-type-css.svg" alt="CSS" />
              </div>
              <span class="tech-name">CSS</span>
            </div>
          </div>
        </div>

        <!-- Backend & APIs -->
        <div class="tech-category">
          <h4 class="category-title">Backend & APIs</h4>
          <div class="tech-items">
            <div class="tech-item">
              <div class="tech-icon">
                <img src="https://api.iconify.design/logos/python.svg" alt="Python" />
              </div>
              <span class="tech-name">Python</span>
            </div>
            
            <div class="tech-item">
              <div class="tech-icon">
                <img src="https://api.iconify.design/logos/nodejs-icon.svg" alt="Node.js" />
              </div>
              <span class="tech-name">Node.js</span>
            </div>
            
            <div class="tech-item">
              <div class="tech-icon">
                <img src="https://api.iconify.design/skill-icons/expressjs-light.svg" alt="Express" />
              </div>
              <span class="tech-name">Express</span>
            </div>
            
            <div class="tech-item">
              <div class="tech-icon">
                <img src="https://api.iconify.design/skill-icons/flask-light.svg" alt="Flask" />
              </div>
              <span class="tech-name">Flask</span>
            </div>
            
            <div class="tech-item">
              <div class="tech-icon">
                <img src="https://api.iconify.design/logos/fastapi-icon.svg" alt="FastAPI" />
              </div>
              <span class="tech-name">FastAPI</span>
            </div>
          </div>
        </div>

        <!-- Databases -->
        <div class="tech-category">
          <h4 class="category-title">Databases</h4>
          <div class="tech-items">
            <div class="tech-item">
              <div class="tech-icon">
                <img src="https://api.iconify.design/logos/mysql.svg" alt="MySQL" />
              </div>
              <span class="tech-name">MySQL</span>
            </div>
            
            <div class="tech-item">
              <div class="tech-icon">
                <img src="https://api.iconify.design/logos/postgresql.svg" alt="PostgreSQL" />
              </div>
              <span class="tech-name">PostgreSQL</span>
            </div>
            
            <div class="tech-item">
              <div class="tech-icon">
                <img src="https://api.iconify.design/logos/firebase.svg" alt="Firebase" />
              </div>
              <span class="tech-name">Firebase</span>
            </div>
          </div>
        </div>

        <!-- Tools & Hardware -->
        <div class="tech-category">
          <h4 class="category-title">Tools & Hardware</h4>
          <div class="tech-items">
            <div class="tech-item">
              <div class="tech-icon">
                <img src="https://api.iconify.design/logos/git-icon.svg" alt="Git" />
              </div>
              <span class="tech-name">Git</span>
            </div>
            
            <div class="tech-item">
              <div class="tech-icon">
                <img src="https://api.iconify.design/mdi/github.svg" alt="GitHub" />
              </div>
              <span class="tech-name">GitHub</span>
            </div>
            
            <div class="tech-item">
              <div class="tech-icon">
                <img src="https://api.iconify.design/logos/visual-studio-code.svg" alt="VS Code" />
              </div>
              <span class="tech-name">VS Code</span>
            </div>
            
            <div class="tech-item">
              <div class="tech-icon">
                <img src="https://api.iconify.design/logos/postman-icon.svg" alt="Postman" />
              </div>
              <span class="tech-name">Postman</span>
            </div>
            
            <div class="tech-item">
              <div class="tech-icon">
                <img src="https://api.iconify.design/devicon/arduino-wordmark.svg" alt="Arduino" />
              </div>
              <span class="tech-name">Arduino</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>