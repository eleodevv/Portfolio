---
const technologies = [
  { name: "React", color: "#61DAFB", icon: "https://api.iconify.design/logos/react.svg" },
  { name: "Expo", color: "#000020", icon: "https://api.iconify.design/cib/expo.svg" },
  { name: "Flutter", color: "#02569B", icon: "https://api.iconify.design/logos/flutter.svg" },
  { name: "Python", color: "#3776AB", icon: "https://api.iconify.design/logos/python.svg" },
  { name: "Flet", color: "#FF6B6B", icon: "/flet.png" },
  { name: "Flask", color: "#FFFFFF", icon: "https://api.iconify.design/skill-icons/flask-light.svg" },
  { name: "FastAPI", color: "#009688", icon: "https://api.iconify.design/logos/fastapi-icon.svg" },
  { name: "JavaScript", color: "#F7DF1E", icon: "https://api.iconify.design/logos/javascript.svg" },
  { name: "HTML", color: "#E34F26", icon: "https://api.iconify.design/vscode-icons/file-type-html.svg" },
  { name: "CSS", color: "#1572B6", icon: "https://api.iconify.design/vscode-icons/file-type-css.svg" },
  { name: "Arduino", color: "#00979D", icon: "https://api.iconify.design/devicon/arduino-wordmark.svg" }
];
---

<section id="tech-stack" class="tech-stack">
  <div class="container">
    <div class="stack-wrapper">
      <div class="stack-title">
        <h2>Stack</h2>
      </div>
      
      <div class="tech-river">
        {technologies.map((tech, index) => (
          <div 
            class="tech-tile"
            style={`--tech-color: ${tech.color}; --tile-index: ${index};`}
          >
            <div class="tile-shine"></div>
            <div class="tile-content">
              <img src={tech.icon} alt={tech.name} class="tile-icon" />
              <span class="tile-name">{tech.name}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .tech-stack {
    padding: 8rem 0;
    background: var(--bg);
  }

  .stack-wrapper {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .stack-title h2 {
    font-size: clamp(4rem, 8vw, 7rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  .tech-river {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .tech-tile {
    position: relative;
    background: var(--bg);
    border: 1.5px solid var(--border);
    border-radius: 16px;
    padding: 2rem 2.5rem;
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    animation: tileSlide 0.8s ease-out backwards;
    animation-delay: calc(var(--tile-index) * 0.08s);
  }

  @keyframes tileSlide {
    from {
      opacity: 0;
      transform: translateX(-60px) rotate(-5deg);
    }
    to {
      opacity: 1;
      transform: translateX(0) rotate(0deg);
    }
  }

  .tile-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      transparent 30%,
      rgba(255, 255, 255, 0.1) 50%,
      transparent 70%
    );
    transform: translateX(-100%);
    transition: transform 0.8s ease;
  }

  .tech-tile:hover .tile-shine {
    transform: translateX(100%);
  }

  .tech-tile:hover {
    border-color: var(--tech-color);
    transform: translateY(-8px) scale(1.05);
    box-shadow: 
      0 20px 60px rgba(0, 0, 0, 0.12),
      0 0 0 2px var(--tech-color);
  }

  [data-theme="dark"] .tech-tile:hover {
    box-shadow: 
      0 20px 60px rgba(0, 0, 0, 0.5),
      0 0 0 2px var(--tech-color);
  }

  .tile-content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .tile-icon {
    width: 48px;
    height: 48px;
    object-fit: contain;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.1));
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .tech-tile:hover .tile-icon {
    transform: scale(1.15) rotate(-5deg);
    filter: drop-shadow(0 8px 24px var(--tech-color));
  }

  .tile-name {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
    transition: color 0.3s ease;
  }

  .tech-tile:hover .tile-name {
    color: var(--tech-color);
  }

  /* Variaciones de tamaño */
  .tech-tile:nth-child(1),
  .tech-tile:nth-child(5),
  .tech-tile:nth-child(9) {
    padding: 2.5rem 3rem;
  }

  .tech-tile:nth-child(1) .tile-icon,
  .tech-tile:nth-child(5) .tile-icon,
  .tech-tile:nth-child(9) .tile-icon {
    width: 56px;
    height: 56px;
  }

  .tech-tile:nth-child(1) .tile-name,
  .tech-tile:nth-child(5) .tile-name,
  .tech-tile:nth-child(9) .tile-name {
    font-size: 1.4rem;
  }

  @media (max-width: 1024px) {
    .tech-river {
      gap: 1.25rem;
    }

    .tech-tile {
      padding: 1.75rem 2.25rem;
    }

    .tile-icon {
      width: 40px;
      height: 40px;
    }

    .tile-name {
      font-size: 1.1rem;
    }

    .tech-tile:nth-child(1),
    .tech-tile:nth-child(5),
    .tech-tile:nth-child(9) {
      padding: 2rem 2.5rem;
    }

    .tech-tile:nth-child(1) .tile-icon,
    .tech-tile:nth-child(5) .tile-icon,
    .tech-tile:nth-child(9) .tile-icon {
      width: 48px;
      height: 48px;
    }

    .tech-tile:nth-child(1) .tile-name,
    .tech-tile:nth-child(5) .tile-name,
    .tech-tile:nth-child(9) .tile-name {
      font-size: 1.25rem;
    }
  }

  @media (max-width: 768px) {
    .stack-wrapper {
      gap: 3rem;
    }

    .tech-river {
      gap: 1rem;
      justify-content: center;
    }

    .tech-tile {
      padding: 1.5rem 2rem;
    }

    .tile-content {
      gap: 1rem;
    }

    .tile-icon {
      width: 36px;
      height: 36px;
    }

    .tile-name {
      font-size: 1rem;
    }

    .tech-tile:nth-child(1),
    .tech-tile:nth-child(5),
    .tech-tile:nth-child(9) {
      padding: 1.75rem 2.25rem;
    }

    .tech-tile:nth-child(1) .tile-icon,
    .tech-tile:nth-child(5) .tile-icon,
    .tech-tile:nth-child(9) .tile-icon {
      width: 44px;
      height: 44px;
    }

    .tech-tile:nth-child(1) .tile-name,
    .tech-tile:nth-child(5) .tile-name,
    .tech-tile:nth-child(9) .tile-name {
      font-size: 1.15rem;
    }
  }
</style>
