---
---

<section id="proyectos" class="projects">
  <div class="container">
    <div class="projects-header">
      <h2>Proyectos</h2>
      <p>Organizados por categoría</p>
    </div>
    
    <!-- Categoría: IoT & Hardware -->
    <div class="category-section">
      <h3 class="category-title">IoT & Hardware</h3>
      <div class="bento-grid">
        <article class="bento-item bento-featured">
          <div class="bento-image">
            <img src="/project-blyk.jpg" alt="BLYK.OS" />
          </div>
          <div class="bento-content">
            <span class="bento-year">2025</span>
            <h3>BLYK.OS</h3>
            <p>App BLE para cerradura inteligente vía ESP32. Control remoto, gestión de accesos y monitoreo en tiempo real.</p>
            <div class="bento-stack">
              <span>Flutter</span>
              <span>ESP32</span>
              <span>BLE</span>
            </div>
            <a href="#" class="bento-link">
              Ver proyecto
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10M13 8l-4-4M13 8l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </a>
          </div>
        </article>
      </div>
    </div>

    <!-- Categoría: Developer Tools -->
    <div class="category-section">
      <h3 class="category-title">Developer Tools</h3>
      <div class="bento-grid">
        <article class="bento-item bento-featured">
          <div class="bento-image">
            <img src="/project-cronux.jpg" alt="CRONUX-CRX" />
          </div>
          <div class="bento-content">
            <span class="bento-year">2025</span>
            <h3>CRONUX-CRX</h3>
            <p>Controlador de versiones minimalista con CLI y UI. Simple para usuarios técnicos y no técnicos.</p>
            <div class="bento-stack">
              <span>Python</span>
              <span>Flet</span>
              <span>CLI</span>
            </div>
            <a href="#" class="bento-link">
              Ver proyecto
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10M13 8l-4-4M13 8l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </a>
          </div>
        </article>
      </div>
    </div>

    <!-- Categoría: Mobile Apps -->
    <div class="category-section">
      <h3 class="category-title">Mobile Apps</h3>
      <div class="bento-grid bento-grid-mobile">
        <article class="bento-item bento-medium">
          <div class="bento-content">
            <span class="bento-year">2024</span>
            <h3>Mochila App</h3>
            <p>Organizador de eventos extraclase para estudiantes universitarios. Gestión de convivios, fiestas y actividades.</p>
            <div class="bento-stack">
              <span>React Native</span>
              <span>Firebase</span>
            </div>
            <a href="#" class="bento-link">
              Ver proyecto
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10M13 8l-4-4M13 8l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </a>
          </div>
        </article>
      </div>
    </div>

    <!-- Categoría: Web Apps & AI -->
    <div class="category-section">
      <h3 class="category-title">Web Apps & AI</h3>
      <div class="bento-grid bento-grid-web">
        <article class="bento-item bento-medium">
          <div class="bento-content">
            <span class="bento-year">2024</span>
            <h3>Echoa</h3>
            <p>Detección de canciones mediante IA con catálogo de reconocimiento musical en tiempo real.</p>
            <div class="bento-stack">
              <span>Web</span>
              <span>IA</span>
              <span>Audio</span>
            </div>
            <a href="#" class="bento-link">
              Ver proyecto
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10M13 8l-4-4M13 8l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </a>
          </div>
        </article>

        <article class="bento-item bento-medium">
          <div class="bento-image">
            <img src="/project-nexu.jpg" alt="Nexu" />
          </div>
          <div class="bento-content">
            <span class="bento-year">2024</span>
            <h3>Nexu</h3>
            <p>Juego de mesa físico con cartas + app web para aprender componentes electrónicos de forma interactiva.</p>
            <div class="bento-stack">
              <span>Web App</span>
              <span>Game Design</span>
            </div>
            <a href="#" class="bento-link">
              Ver proyecto
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10M13 8l-4-4M13 8l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </a>
          </div>
        </article>
      </div>
    </div>

    <!-- Categoría: Freelance -->
    <div class="category-section">
      <h3 class="category-title">Freelance</h3>
      <div class="bento-grid bento-grid-freelance">
        <article class="bento-item bento-small">
          <div class="bento-content">
            <span class="bento-year">Cliente</span>
            <h3>Sistema de Nómina</h3>
            <p>App web para cálculo automatizado de nómina empresarial.</p>
            <div class="bento-stack">
              <span>Web App</span>
            </div>
            <a href="#" class="bento-link">
              Ver proyecto
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10M13 8l-4-4M13 8l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </a>
          </div>
        </article>

        <article class="bento-item bento-small">
          <div class="bento-content">
            <span class="bento-year">Cliente</span>
            <h3>Sistema de Nómina v2</h3>
            <p>Rediseño completo con nueva interfaz y funcionalidades mejoradas.</p>
            <div class="bento-stack">
              <span>Web App</span>
            </div>
            <a href="#" class="bento-link">
              Ver proyecto
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10M13 8l-4-4M13 8l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </a>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>
